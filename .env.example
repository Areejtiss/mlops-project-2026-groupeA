# Copy this file to .env and replace the placeholders with real values.
# .env is git-ignored: never commit real credentials.

# MinIO admin account (also used as DVC access key / secret key)
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-min-8-chars

# Host ports for MinIO. Change them only if 9000/9001 are already used on your
# machine, then also set the DVC endpoint in .dvc/config.local (see README).
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# MLflow tracking server started by `docker compose up -d mlflow`. Training
# logs a run only when this variable is set in the shell (the code does not read
# .env), e.g. PowerShell: $env:MLFLOW_TRACKING_URI = "http://localhost:5000"
# Host port of the MLflow UI/API. Change it only if 5000 is taken, and use the
# same port in MLFLOW_TRACKING_URI.
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://localhost:5000
# Clients on the HOST must also set this: otherwise MLflow 3.17 downloads
# artifacts (load_model) through presigned URLs signed for http://minio:9000,
# a name only containers resolve, and the download hangs. Containers in this
# compose network (e.g. the API) do not need it.
MLFLOW_ENABLE_PROXY_MULTIPART_DOWNLOAD=false

# Kaggle API credentials (kaggle.com > Settings > API).
# Use EITHER the new API token, OR the legacy username + key (from kaggle.json).
# KAGGLE_API_TOKEN=your-kaggle-api-token
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-key
