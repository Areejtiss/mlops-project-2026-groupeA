# Copy this file to .env and replace the placeholders with real values.
# .env is git-ignored: never commit real credentials.

# MinIO admin account (also used as DVC access key / secret key)
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-min-8-chars

# Host ports for MinIO. Change them only if 9000/9001 are already used on your
# machine, then also set the DVC endpoint in .dvc/config.local (see README).
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Kaggle API credentials (kaggle.com > Settings > API > Create New Token)
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-key
